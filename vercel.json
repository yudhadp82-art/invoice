{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/tgapi/(.*)", "destination": "https://api.telegram.org/$1" },
    { "source": "/orapi/(.*)", "destination": "https://openrouter.ai/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
